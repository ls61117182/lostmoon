    "destroyed": { "path": "source_art/tanks/kv1/destroyed-selected.png", "background": "alpha" }
  },
  "processing": {
    "alphaThreshold": 32,
    "commonScale": 0.089,
    "outlinePixels": 0,
    "hullPadding": [1, 1, 1, 1],
    "turretPadding": [1, 1, 1, 1]
  },
  "sourceGeometry": {
    "hullPivot": [900, 445],
    "turretPivot": [1050, 465],
