CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: water-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.01 }
        waterMask: { value: white }
        chunkBounds: { value: [0, 0, 386, 386] }
        waterClock: { value: [0, 0, 0, 0] }
        waterUv: { value: [0, 0, 0, 0] }
}%
CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram water-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform sampler2D waterMask;
  uniform WaterParams { vec4 chunkBounds; vec4 waterClock; vec4 waterUv; };

  float waterHash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
  }

  // Smooth irregular fields sampled in map coordinates, continuous across chunks.
  float waterNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(waterHash(i), waterHash(i + vec2(1.0, 0.0)), f.x),
      mix(waterHash(i + vec2(0.0, 1.0)), waterHash(i + vec2(1.0)), f.x), f.y);
  }

  vec4 frag () {
    vec4 mask = texture(waterMask, uv0);
    vec2 mapUV = vec2(uv0.x, mix(uv0.y, 1.0 - uv0.y, waterUv.x));
    vec2 p = chunkBounds.xy + mapUV * chunkBounds.zw;
    float t = waterClock.x * mask.g;
    // Drift and bend the wave domains locally instead of repeating straight bands.
    float scale = mix(1.25, 0.65, mask.b);
    vec2 w = p * scale;
    float bendA = waterNoise(w * 0.035 + vec2(-t * 0.07, t * 0.025));
    float bendB = waterNoise(w * 0.052 + vec2(t * 0.035, -t * 0.055) + vec2(43.7, 19.2));
    vec2 bent = w + (vec2(bendA, bendB) - 0.5) * 24.0;
    float a = sin(bent.x * 0.19 + bent.y * 0.075 - t * 0.85 + bendB * 4.0);
    float b = sin(bent.x * -0.085 + bent.y * 0.23 + t * 0.62 + bendA * 3.5);
    // Break long crests into uneven patches which change as the water drifts.
    float patches = waterNoise(w * 0.085 + vec2(-t * 0.11, t * 0.045) + vec2(8.3, 57.1));
    float detail = waterNoise(bent * 0.16 + vec2(t * 0.06, -t * 0.09));
    vec2 shift = vec2(a, b) * 0.55 * mask.r / chunkBounds.zw;
    shift.y *= mix(1.0, -1.0, waterUv.x);
    vec2 sampleUV = clamp(uv0 + shift, vec2(0.0), vec2(1.0));
    // Also check the destination mask so banks and bridges remain stationary.
    shift *= texture(waterMask, sampleUV).r;
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + shift);
    float crest = pow(max(0.0, a * 0.55 + b * 0.45 + (detail - 0.5) * 0.45), 3.0);
    crest *= smoothstep(0.25, 0.70, patches);
    float light = (crest * 0.12 + (detail - 0.5) * 0.018 + a * b * 0.012 - 0.009) * mask.r;
    light *= mix(0.40, 1.0, mask.g);
    // The Pacific deep-sea artwork has dense static whitecaps; stronger moving
    // highlights remain readable over it, with the larger wave scale above.
    float deepSea = smoothstep(0.68, 0.85, mask.b);
    light *= mix(1.0, 1.65, deepSea);
    float winterWater = clamp((1.0 - mask.a) * 2.0, 0.0, 1.0);
    light *= mix(1.0, 1.85, winterWater);
    o.rgb = clamp(o.rgb + vec3(0.65, 0.86, 0.92) * light, 0.0, 1.0);
    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
