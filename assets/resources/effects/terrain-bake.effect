CCEffect %{
  techniques:
  - passes:
    - vert: terrain-vs:vert
      frag: terrain-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: false
      rasterizerState:
        cullMode: none
      properties:
        terrainAtlas: { value: white }
        tileGround: { value: black }
        tileRoads: { value: black }
        chunkBounds: { value: [0, 0, 386, 386] }
        tileBounds: { value: [0, 0, 1, 1] }
        terrainStyle: { value: [0, 0, 0, 0] }
        bakeOptions: { value: [0, 0, 0, 0] }
}%
CCProgram terrain-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 mapUV;
  vec4 vert () {
    mapUV=a_texCoord;
    vec4 pos=vec4(a_position,1.0);
    #if USE_LOCAL
      pos=cc_matWorld*pos;
    #endif
    return cc_matViewProj*pos;
  }
}%
CCProgram terrain-fs %{
  precision highp float;
  in vec2 mapUV;
  uniform sampler2D terrainAtlas;
  uniform sampler2D tileGround;
  uniform sampler2D tileRoads;
  uniform TerrainParams { vec4 chunkBounds; vec4 tileBounds; vec4 terrainStyle; vec4 bakeOptions; };
  const float SQ=1.7320508075688772;
  const float R=48.0;
  const float PI=3.141592653589793;
  float flag(float value,float bit) { return mod(floor(value/exp2(bit)),2.0); }
  float noise(vec2 p) { return sin(p.x*.055+p.y*.016)*.47+sin(p.x*.022-p.y*.068)*.32+sin(p.x*.113+p.y*.091)*.21; }
  vec2 axis(int i) { float a=float(i)*PI/3.0;return vec2(cos(a),sin(a)); }
  vec2 neighbour(int i) {
    if(i==0)return vec2(1,0);if(i==1)return vec2(0,1);if(i==2)return vec2(-1,1);
    if(i==3)return vec2(-1,0);if(i==4)return vec2(0,-1);return vec2(1,-1);
  }
  vec2 axialAt(vec2 p) {
    float r=p.y/(1.5*R),q=p.x/(SQ*R)-r*.5;
    vec3 cube=vec3(q,r,-q-r),rounded=floor(cube+.5),err=abs(rounded-cube);
    if(err.x>err.y&&err.x>err.z)rounded.x=-rounded.y-rounded.z;
    else if(err.y>err.z)rounded.y=-rounded.x-rounded.z;
    return rounded.xy;
  }
  vec2 center(vec2 qr) { return vec2(SQ*R*(qr.x+qr.y*.5),1.5*R*qr.y); }
  vec4 tile(vec2 qr) {
    vec2 p=qr-tileBounds.xy;
    if(p.x<0.0||p.y<0.0||p.x>=tileBounds.z||p.y>=tileBounds.w)return vec4(0);
    return floor(texture(tileGround,(p+.5)/tileBounds.zw)*255.0+.5);
  }
  vec4 roadInfo(vec2 qr) { return floor(texture(tileRoads,(qr-tileBounds.xy+.5)/tileBounds.zw)*255.0+.5); }
  float hexDistance(vec2 p) { return max(abs(p.x),abs(p.x)*.5+abs(p.y)*SQ*.5)-SQ*R*.5; }
  float waterMaterial(float id) { return (id==4.0||id==5.0||id==8.0||id==11.0)?1.0:0.0; }
  vec3 sampleArt(float id,vec2 p) {
    // Mirror the source art in map coordinates; every block uses the same phase.
    vec2 mirrored=1.0-abs(mod(p/384.0,2.0)-1.0);
    vec2 cell=vec2(mod(id,4.0),floor(id/4.0));
    vec2 uv=(cell*386.0+vec2(1.5)+mirrored*383.0)/vec2(1544.0,1930.0);
    return texture(terrainAtlas,uv).rgb;
  }
  float snowCoverage(float id) {
    if(id==12.0)return .93;if(id==18.0)return .70;if(id==13.0)return .58;
    if(id==14.0)return .72;if(id==15.0)return .50;return .76;
  }
  float inset(vec2 p) { p=abs(p);return min(SQ*.5-p.x,SQ*.5-p.x*.5-p.y*SQ*.5); }
  vec2 countryWarp(vec2 p,float variant) {
    float envelope=smoothstep(0.0,.68,inset(p)),phase=mod(variant,3.0)*2.1;
    return p+vec2(.07*sin(p.y*1.9+phase+.5),.11*sin(p.x*2.3+phase+1.0))*envelope;
  }
  vec2 roadWarp(vec2 p,float variant) {
    vec4 c=variant<.5?vec4(.032,.055,.35,1.15):variant<1.5?vec4(-.045,.043,1.80,-.40):vec4(.052,-.046,-1.05,2.20);
    float e=smoothstep(0.0,.78,inset(p));
    return p+e*vec2(c.x*sin(p.y*1.65+c.z)+c.y*.18*sin((p.x+p.y)*1.25-c.w),c.y*sin(p.x*1.55+c.w)-c.x*.16*sin((p.x-p.y)*1.35+c.z));
  }
  float curvedDistance(vec2 p,vec4 info) {
    p.y=-p.y;p=countryWarp(p/R,info.b);
    float a=info.g*PI/3.0;p=vec2(p.x*cos(a)-p.y*sin(a),p.x*sin(a)+p.y*cos(a));
    p=roadWarp(p,info.b);
    float distances[6];vec2 dirs[6];float count=0.0,result=1000.0;vec2 u=vec2(0),v=vec2(0);
    for(int i=0;i<6;i++) {
      dirs[i]=axis(i)*vec2(1,-1);distances[i]=1000.0;
      if(flag(info.r,float(i))>.5) {
        if(count<.5)u=dirs[i];else v=dirs[i];count+=1.0;
        distances[i]=dot(p,dirs[i])>=0.0?abs(p.x*dirs[i].y-p.y*dirs[i].x):length(p);
        result=min(result,distances[i]);
      }
    }
    if(count<1.5)return min(result,length(p)-.18*.6)*R;
    if(count<2.5&&dot(u,v)>-.99) {
      float angle=acos(clamp(dot(u,v),-1.0,1.0)),radius=43.0/128.0,tangent=radius/tan(angle*.5);
      vec2 c=normalize(u+v)*radius/sin(angle*.5);
      float start=atan(tangent*u.y-c.y,tangent*u.x-c.x),end=atan(tangent*v.y-c.y,tangent*v.x-c.x);
      float sweep=atan(sin(end-start),cos(end-start)),theta=atan(p.y-c.y,p.x-c.x);
      float relative=atan(sin(theta-start),cos(theta-start));
      result=1000.0;
      float alongU=dot(p,u)-tangent,alongV=dot(p,v)-tangent;
      result=min(alongU>=0.0?abs(p.x*u.y-p.y*u.x):length(p-tangent*u),alongV>=0.0?abs(p.x*v.y-p.y*v.x):length(p-tangent*v));
      if(relative*sign(sweep)>=0.0&&abs(relative)<=abs(sweep))result=min(result,abs(length(p-c)-radius));
    } else {
      for(int i=0;i<6;i++)for(int j=0;j<6;j++) {
        if(j<=i||flag(info.r,float(i))<.5||flag(info.r,float(j))<.5)continue;
        if(dot(dirs[i],dirs[j])<-.99||dot(p,dirs[i])<0.0||dot(p,dirs[j])<0.0)continue;
        float blend=max(0.0,1.0-abs(distances[i]-distances[j])/(30.0/128.0));
        result=min(result,min(distances[i],distances[j])-(30.0/128.0)*blend*blend*.25);
      }
    }
    return result*R;
  }
  float roadDistance(vec2 p,vec4 t,vec4 info,bool curved) {
    if(t.g<.5||t.b>.5||flag(t.a,0.0)>.5)return 1000.0;
    if(curved) { if(hexDistance(p)>R*.08)return 1000.0;return curvedDistance(p,info); }
    float result=1000.0,end=SQ*R*.5+R*.08;
    for(int i=0;i<6;i++)if(flag(t.g,float(i))>.5) {
      vec2 n=axis(i);float along=clamp(dot(p,n)/end,0.0,1.0);result=min(result,length(p-n*end*along));
    }
    return result;
  }
  float runwayAxis(vec4 t) {
    float result=0.0;
    for(int i=0;i<6;i++)if(flag(t.g,float(i))>.5) {result=mod(float(i),3.0);if(flag(t.g,mod(float(i+3),6.0))>.5)break;}
    return result;
  }
  vec4 frag () {
    vec2 p=chunkBounds.xy+mapUV*chunkBounds.zw,qr=axialAt(p),wx=p*1.25;
    vec4 owner=tile(qr);if(owner.r<.5)return vec4(0);
    bool winter=terrainStyle.x>.5,curved=terrainStyle.z>.5&&(!winter||terrainStyle.w>.5);
    float warp=R*(winter?.11:.19),band=R*(winter?.30:.25);
    vec2 warped=p+vec2(noise(wx*vec2(.82,.9)+vec2(38,0)),noise(wx*vec2(.83,.84)+vec2(-17,53)))*warp;
    float weights[7];float ids[7];vec4 data[7];vec2 positions[7];
    float sum=0.0,water=0.0,coverage=0.0,paving=0.0,deep=0.0,shallow=0.0,landDistance=1000.0,nearestLand=-1.0;
    for(int i=0;i<7;i++) {
      positions[i]=qr+(i==0?vec2(0):neighbour(i-1));data[i]=tile(positions[i]);ids[i]=data[i].r-1.0;
      float d=hexDistance(warped-center(positions[i]));
      weights[i]=data[i].r>.5?1.0-smoothstep(-band,band,d):0.0;sum+=weights[i];
      float w=weights[i];water+=waterMaterial(ids[i])*w;coverage+=(1.0-waterMaterial(ids[i]))*snowCoverage(ids[i])*w;
      if(ids[i]==6.0||ids[i]==15.0)paving+=w;if(ids[i]==5.0)deep+=w;if(ids[i]==11.0)shallow+=w;
      if(data[i].r>.5&&waterMaterial(ids[i])<.5) {float ld=hexDistance(p-center(positions[i]));if(ld<landDistance){landDistance=ld;nearestLand=ids[i];}}
    }
    sum=max(sum,.00001);water/=sum;paving/=sum;deep/=sum;shallow/=sum;
    coverage/=max(.00001,sum*(1.0-water));
    float waterAlpha=smoothstep(.70,.90,water);
    if(nearestLand>=0.0)waterAlpha*=smoothstep(R*.01,R*.04,landDistance);
    float motion=smoothstep(.96,1.0,waterAlpha);
    float frost=winter?smoothstep(-.18,.18,noise(wx*.48)*.65+coverage-.44)*(terrainStyle.w>.5?.35:1.0):0.0;
    vec3 landColor=vec3(0),waterColor=vec3(0);float landSum=0.0,waterSum=0.0;
    for(int i=0;i<7;i++)if(weights[i]>.00001) {
      float id=ids[i];vec3 c=sampleArt(id,wx);
      if(waterMaterial(id)>.5) {c=c*.70+(sampleArt(id,wx-vec2(8,-5))+sampleArt(id,wx+vec2(8,-5)))*.15;waterColor+=c*weights[i];waterSum+=weights[i];}
      else {if(winter)c=mix(c,sampleArt(7.0,wx),frost);landColor+=c*weights[i];landSum+=weights[i];}
    }
    if(landSum<.00001&&nearestLand>=0.0) {landColor=sampleArt(nearestLand,wx);if(winter)landColor=mix(landColor,sampleArt(7.0,wx),frost);landSum=1.0;}
    vec3 color=mix(landColor/max(landSum,.00001),waterColor/max(waterSum,.00001),waterAlpha);
    if(water>.0001&&water<.9999) {
      float bank=4.0*waterAlpha*(1.0-waterAlpha)*(winter?.96:.88);
      float dark=(1.0-smoothstep(.045,.10,abs(waterAlpha-.83)))*(winter?.04:.12);
      float ice=winter?smoothstep(.55,.72,waterAlpha)*(1.0-smoothstep(.86,.99,waterAlpha))*.42:0.0;
      color=mix(mix(color,sampleArt(winter?7.0:3.0,wx),bank)*(1.0-dark),vec3(168,190,194)/255.0,ice);
    }
    vec2 local=p-center(qr);vec4 ownRoad=roadInfo(qr);
    if(flag(owner.a,2.0)>.5) {
      float radius=length(local/R/vec2(.76,.67)),irregular=sin(local.x/R*12.0+local.y/R*7.0)*.025+sin(local.y/R*15.0-local.x/R*6.0)*.018;
      float alpha=1.0-smoothstep(.78,1.02,radius+irregular);
      color=mix(color,sampleArt(winter&&bakeOptions.z>.5?19.0:10.0,wx),alpha);motion=0.0;
    }
    if(flag(owner.a,1.0)>.5) {
      float edge=-1000.0;
      for(int i=0;i<6;i++)if(flag(ownRoad.a,float(i))<.5)edge=max(edge,dot(local,axis(i))-SQ*R*.5);
      float alpha=smoothstep(-.43,-.30,noise(p*2.8+vec2(103,-71)))*(1.0-smoothstep(-R*.055,-R*.02,edge));
      color=mix(color,sampleArt(2.0,wx),alpha*.86);
    }
    float runwayAlpha=0.0,roadD=1000.0;
    for(int i=0;i<7;i++)if(data[i].r>.5) {
      vec2 loc=p-center(positions[i]);
      if(flag(data[i].a,0.0)>.5) {
        float a=runwayAxis(data[i]);vec2 n=vec2(cos(a*PI/3.0),sin(a*PI/3.0)),dq=neighbour(int(a));
        vec4 before=tile(positions[i]-dq),after=tile(positions[i]+dq);
        float start=flag(before.a,0.0)>.5&&runwayAxis(before)==a?-SQ*R*.5:-SQ*R*.5*.60;
        float end=flag(after.a,0.0)>.5&&runwayAxis(after)==a?SQ*R*.5:SQ*R*.5*.60;
        float u=dot(loc,n),v=abs(-loc.x*n.y+loc.y*n.x);
        runwayAlpha=max(runwayAlpha,(1.0-smoothstep(R*.42-R*.012,R*.42+R*.012,v))*smoothstep(start-R*.012,start,u)*(1.0-smoothstep(end,end+R*.012,u)));
      }
      roadD=min(roadD,roadDistance(loc,data[i],roadInfo(positions[i]),curved));
    }
    if(runwayAlpha>0.0) {color=mix(color,sampleArt(3.0,wx)*.25+vec3(225,219,195)/255.0*.75,runwayAlpha);motion*=1.0-runwayAlpha;}
    else if(owner.b>.5) {
      float a=(owner.b-1.0)*PI/3.0;vec2 n=vec2(cos(a),sin(a));float u=dot(local,n),v=-local.x*n.y+local.y*n.x,halfWidth=R*.205;
      if(abs(u)<=SQ*R*.5+R*.08+4.0)motion*=smoothstep(halfWidth+R*.028+2.0,halfWidth+R*.028+5.0,abs(v));
      if(abs(u)<=SQ*R*.5+R*.08&&abs(v)<=halfWidth+R*.028) {
        bool rail=abs(v)>halfWidth-R*.027;vec3 c=rail?vec3(78,70,52)/255.0:sampleArt(9.0,vec2(u,v)*2.5);
        if(!rail&&abs(mod(abs(u),R*.13))<R*.009)c*=.68;
        if(winter&&!rail)c=mix(c,sampleArt(7.0,wx),.22);color=c;
      }
    } else if(flag(owner.a,0.0)<.5&&roadD<R*(winter?.36:curved?.40:.25)) {
      float city=smoothstep(.08,.92,paving),halfWidth=R*(curved?.17+noise(wx*.85+vec2(13,-91))*.018:.185+.010*city);
      float alpha=1.0-smoothstep(halfWidth-R*(curved?.014:.006),halfWidth+R*(curved?.022:.034),roadD);
      vec3 rural=sampleArt(winter?14.0:curved&&bakeOptions.y>.5?16.0:1.0,wx),urban=sampleArt(winter?15.0:6.0,wx),snow=sampleArt(7.0,wx);
      if(curved) {float variation=noise(wx*.8+vec2(32,-18)),outer=halfWidth+R*(.21+variation*.025),shoulder=(1.0-smoothstep(halfWidth+R*.04,outer,roadD))*clamp(.46+variation*.24,.18,.70);color=mix(color,sampleArt(winter?14.0:1.0,wx)*.45+(winter?vec3(185,184,177):vec3(180,165,126))/255.0*.55,shoulder);}
      vec3 c=mix(rural,urban*.76,city);
      if(winter)c=mix(c,snow,.28+.50*smoothstep(halfWidth*.55,halfWidth,roadD));
      float edge=curved?0.0:smoothstep(halfWidth*.84,halfWidth,roadD)*.18;
      float tracks=curved?(1.0-smoothstep(R*.008,R*.030,abs(roadD-R*.075)))*.045:0.0;
      color=mix(color,c*(1.0-edge-tracks),alpha);motion*=1.0-alpha;
      if(winter)color=mix(color,snow,smoothstep(halfWidth*.85,halfWidth*1.12,roadD)*(1.0-smoothstep(halfWidth*1.25,R*.36,roadD))*.8);
    }
    if(bakeOptions.x>.5)return vec4(motion,winter?(terrainStyle.w>.5?.50:.28):.72+shallow*.18-deep*.12,winter&&terrainStyle.w>.5?.65:.5+deep*.35,winter?128.0/255.0:1.0);
    return vec4(clamp(color,0.0,1.0),1.0);
  }
}%
